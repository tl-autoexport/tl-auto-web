[Unit]
Description=Run approved TL Auto Chestny enrichment batch continuously

[Timer]
## Each wave handles at most 50 rows. If the shared TL Auto lock is busy,
## this run exits and the next five-minute slot retries the queue.
OnCalendar=*-*-* *:0/5:00
Persistent=true
AccuracySec=30s
Unit=tl-auto-chestny-enrichment.service

[Install]
WantedBy=timers.target
