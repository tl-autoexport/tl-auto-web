[Unit]
Description=TL Auto universal Encar enrichment worker
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/tl-auto
EnvironmentFile=/home/ubuntu/tl-auto/.env
EnvironmentFile=/etc/tl-auto/catalog-proxy.env
Environment=ENCAR_UNIVERSAL_BATCH_SIZE=50
Environment=ENCAR_UNIVERSAL_DELAY_MS=3000
Environment=ENCAR_UNIVERSAL_DRY_RUN=false
# Same lock as the Chestny VPS worker on this host: only one mass Encar
# process may run at a time across both projects.
# Wait for the shared catalog lock instead of losing the entire five-minute
# slot when Chestny report retry or catalog refresh is finishing a batch.
# Radar priority is still enforced by the worker's coordination marker.
ExecStart=/usr/bin/flock -w 240 -E 75 /tmp/chestny-prigon-encar.lock /usr/bin/npm run run:encar:universal
SuccessExitStatus=75
TimeoutStartSec=1800
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=false
