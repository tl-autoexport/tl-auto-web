NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local/CI compilation only. Never enable in a deployed TL Auto environment.
TL_AUTO_BUILD_WITHOUT_CATALOG=false
# For production use the final HTTPS domain. Vercel's generated project URL is
# also detected automatically when this variable is omitted.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only maintenance credentials. Do not add these to the public Vercel
# frontend project unless a runtime feature explicitly needs them.
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=


# Temporary fallbacks for projects that have not migrated from legacy JWT keys:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

ENCAR_TARGET=20
ENCAR_MAX_PAGES=2
ENCAR_DRY_RUN=true
ENCAR_HISTORY_ACCESS_TOKEN=
ENCAR_HISTORY_DRY_RUN=true
ENCAR_HISTORY_CONCURRENCY=4

CATALOG_ENCAR_TARGET=420
CATALOG_ENCAR_PAGES=20
CATALOG_MAX_LISTING_AGE_DAYS=90
CATALOG_MIN_MERCEDES=25
CATALOG_MIN_BMW=20
CATALOG_MIN_AUDI=15
CATALOG_MIN_MERCEDES_A_CLASS=2
CATALOG_MIN_MERCEDES_C_CLASS=2
CATALOG_MIN_MERCEDES_E_CLASS=4
CATALOG_MIN_MERCEDES_S_CLASS=2
CATALOG_MIN_MERCEDES_GLC=3
CATALOG_MIN_MERCEDES_GLE=2
CATALOG_MIN_MERCEDES_GLS=2
CATALOG_PRIORITY_PAGES_MERCEDES=10
CATALOG_MIN_TOTAL=500
CATALOG_MIN_ENCAR_FETCH=100
CATALOG_MAX_VISIBLE_DROP_PERCENT=10
CATALOG_SYNC_DRY_RUN=true

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Kazakhstan / Almaty landed-price calculation. Customs in Kazakhstan is not
# included. Keep blank until TL Auto confirms the commercial tariffs.
KZ_KOREA_EXPENSES_KRW=
KZ_ALMATY_DELIVERY_USD=
KZ_SERVICE_FEE_KZT=
